# Copy to .env and fill in only the providers you use. NEVER commit .env.
PROXY_PORT=8787
# Comma-separated browser origins allowed to call the proxy
PROXY_ALLOWED_ORIGINS=http://localhost:5173,https://stevenke1981.github.io
XAI_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
RUNWAYML_API_SECRET=
LUMAAI_API_KEY=
# Kling: either a single API key, or the legacy access/secret key pair (JWT signed by the proxy)
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
