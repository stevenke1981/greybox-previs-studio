{
  "name": "greybox-previs-studio",
  "version": "0.1.0",
  "private": true,
  "description": "three.js greybox (白模) previs studio: pose mannequins, keyframe cameras, export stills/passes/video, and send them to image/video generation models.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "proxy": "node server/proxy.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mp4-muxer": "^5.2.2",
    "three": "^0.186.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
